{
  "manifest_version": 3,
  "name": "DAYFLOW Focus",
  "version": "1.0.0",
  "description": "Blocks distracting websites during DAYFLOW focus sessions and focus schedules.",
  "key": "",
  "permissions": ["declarativeNetRequest", "storage", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "externally_connectable": {
    "matches": [
      "http://localhost:5173/*",
      "http://127.0.0.1:5173/*",
      "http://localhost:4173/*",
      "https://maevillareal.github.io/*"
    ]
  },
  "action": { "default_title": "DAYFLOW Focus", "default_popup": "popup.html", "default_icon": { "128": "icon-128.png" } },
  "icons": { "128": "icon-128.png" },
  "web_accessible_resources": [{ "resources": ["blocked.html", "blocked.css", "icon-128.png"], "matches": ["<all_urls>"] }]
}
