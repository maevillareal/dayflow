# Copy to .env.local and fill in from Supabase → Project Settings → API.
# The anon/publishable key is meant to be public in browser code. Never put the service_role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Chrome extension ID shown on chrome://extensions after "Load unpacked" (fixed by the key in extension/manifest.json).
VITE_EXTENSION_ID=
